<UserControl x:Class="LabelStudio.App.Controls.MediaDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168" Height="104">
  <Grid>
    <!-- Media strip: three labels travelling downwards, as seen from above the printer. -->
    <Canvas x:Name="Strip">
      <Rectangle Canvas.Left="44" Canvas.Top="0" Width="80" Height="104" RadiusX="2" RadiusY="2"
                 Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
      <Rectangle Canvas.Left="48" Canvas.Top="4" Width="72" Height="40" RadiusX="2" RadiusY="2"
                 Fill="{ThemeResource LayerFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
      <Rectangle Canvas.Left="48" Canvas.Top="52" Width="72" Height="40" RadiusX="2" RadiusY="2"
                 Fill="{ThemeResource LayerFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Canvas>
    <!-- GapCentre: sensor fixed on the centre line, reading the gap between labels. -->
    <Canvas x:Name="GapCentre" Visibility="Collapsed">
      <Line X1="84" Y1="0" X2="84" Y2="104" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeDashArray="3,2" />
      <Ellipse Canvas.Left="78" Canvas.Top="42" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
    </Canvas>
    <!-- MarkLeft: black mark sensor travel from centre to the left edge only. -->
    <Canvas x:Name="MarkLeft" Visibility="Collapsed">
      <Rectangle Canvas.Left="52" Canvas.Top="44" Width="14" Height="8" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
      <Line X1="46" Y1="100" X2="84" Y2="100" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3" />
      <Line X1="84" Y1="100" X2="122" Y2="100" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="3" StrokeDashArray="2,2" />
    </Canvas>
    <!-- MinimumSize: one label with its minimum width and length dimensioned. -->
    <Canvas x:Name="MinimumSize" Visibility="Collapsed">
      <Line X1="48" Y1="100" X2="120" Y2="100" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
      <Line X1="130" Y1="4" X2="130" Y2="44" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
    </Canvas>
    <!-- TearBar: where the label stops relative to the tear bar. -->
    <Canvas x:Name="TearBar" Visibility="Collapsed">
      <Line X1="30" Y1="48" X2="138" Y2="48" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="3" />
      <Polygon Points="142,40 150,48 142,56" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
    </Canvas>
  </Grid>
</UserControl>
