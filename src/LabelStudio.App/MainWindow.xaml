<Window x:Class="LabelStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabelStudio.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Grid.KeyboardAccelerators>

    <TitleBar x:Name="AppTitleBar" x:Uid="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xE749;" />
      </TitleBar.IconSource>
      <TitleBar.RightHeader>
        <controls:StatusPill Margin="0,0,8,0"
                             Tone="{x:Bind Shell.Status.Tone, Mode=OneWay}"
                             Glyph="{x:Bind Shell.Status.Glyph, Mode=OneWay}"
                             Text="{x:Bind Shell.Status.PillText, Mode=OneWay}"
                             Command="{x:Bind Shell.PillActionCommand}" />
      </TitleBar.RightHeader>
    </TitleBar>

    <!-- Spec §13: left nav, icon rail below 900 px, overlay below 640 px. -->
    <NavigationView x:Name="Nav" Grid.Row="1"
                    PaneDisplayMode="Auto" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640"
                    OpenPaneLength="236" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="True"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="Nav_Home" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_QuickPrint" Tag="quickprint"><NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Printers" Tag="printers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE749;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Designer" Tag="designer"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Templates" Tag="templates"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Nav_Queue" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
