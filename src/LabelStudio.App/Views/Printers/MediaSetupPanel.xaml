<UserControl x:Class="LabelStudio.App.Views.Printers.MediaSetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:LabelStudio.App"
             xmlns:controls="using:LabelStudio.App.Controls">
  <Border Style="{StaticResource CardStyle}">
    <StackPanel Spacing="16">
      <TextBlock x:Uid="MediaSetup_Title" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock x:Uid="MediaSetup_Offline" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Visibility="{x:Bind app:XamlHelpers.CollapsedWhen(ViewModel.IsConnected), Mode=OneWay}" />
      <InfoBar x:Uid="MediaSetup_ReadOnly" Severity="Informational" IsClosable="False"
               IsOpen="{x:Bind app:XamlHelpers.ConnectedButReadOnly(ViewModel.IsConnected, ViewModel.CanEdit), Mode=OneWay}" />
      <InfoBar x:Uid="MediaSetup_Unsaved" Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsDirty, Mode=OneWay}">
        <InfoBar.ActionButton>
          <Button x:Uid="MediaSetup_Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveToPrinterCommand, Mode=OneWay}" />
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar Severity="Error" IsClosable="True" IsOpen="{x:Bind app:XamlHelpers.IsNotNull(ViewModel.CommandError), Mode=OneWay}"
               Message="{x:Bind ViewModel.CommandError, Mode=OneWay}" />

      <RadioButtons x:Uid="MediaSetup_MediaType" MaxColumns="3" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsMediaTypeVisible, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.MediaTypeIndex, Mode=TwoWay}">
        <RadioButton x:Uid="MediaSetup_MediaType_Continuous" />
        <RadioButton x:Uid="MediaSetup_MediaType_Gap" />
        <RadioButton x:Uid="MediaSetup_MediaType_Mark" />
      </RadioButtons>
      <RadioButtons x:Uid="MediaSetup_PrintMethod" MaxColumns="2" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPrintMethodVisible, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.PrintMethodIndex, Mode=TwoWay}">
        <RadioButton x:Uid="MediaSetup_PrintMethod_Transfer" />
        <RadioButton x:Uid="MediaSetup_PrintMethod_Direct" />
      </RadioButtons>
      <RadioButtons x:Uid="MediaSetup_PrintMode" MaxColumns="2" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPrintModeVisible, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.PrintModeIndex, Mode=TwoWay}">
        <RadioButton x:Uid="MediaSetup_PrintMode_TearOff" />
        <RadioButton x:Uid="MediaSetup_PrintMode_Peel" />
      </RadioButtons>

      <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLabelLengthVisible, Mode=OneWay}">
        <NumberBox x:Uid="MediaSetup_LabelLength" SpinButtonPlacementMode="Compact" SmallChange="8" LargeChange="80" MaxWidth="240" HorizontalAlignment="Left"
                   IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                   Minimum="{x:Bind ViewModel.LabelLengthMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.LabelLengthMax, Mode=OneWay}"
                   Value="{x:Bind ViewModel.LabelLengthDots, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind ViewModel.LabelLengthCaption, Mode=OneWay}" Style="{StaticResource NumericValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsPrintWidthVisible, Mode=OneWay}">
        <NumberBox x:Uid="MediaSetup_PrintWidth" SpinButtonPlacementMode="Compact" SmallChange="8" LargeChange="80" MaxWidth="240" HorizontalAlignment="Left"
                   IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Minimum="1" Maximum="{x:Bind ViewModel.PrintWidthMax, Mode=OneWay}"
                   Value="{x:Bind ViewModel.PrintWidthDots, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind ViewModel.PrintWidthCaption, Mode=OneWay}" Style="{StaticResource NumericValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsDarknessVisible, Mode=OneWay}">
        <Slider x:Uid="MediaSetup_Darkness" StepFrequency="1" TickFrequency="5" TickPlacement="Outside" Width="360" HorizontalAlignment="Left"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Minimum="{x:Bind ViewModel.DarknessMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.DarknessMax, Mode=OneWay}"
                Value="{x:Bind ViewModel.Darkness, Mode=TwoWay}" />
      </StackPanel>

      <!-- Outside the darkness block on purpose: a printer that doesn't answer print.tone can still test print. -->
      <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
        <Button x:Uid="MediaSetup_TestPrint" Command="{x:Bind ViewModel.PrintTestLabelCommand, Mode=OneWay}" />
        <TextBlock x:Uid="MediaSetup_TestPrintNotice" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsSpeedVisible, Mode=OneWay}">
        <TextBlock x:Uid="MediaSetup_Speed" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" Style="{StaticResource NumericValueTextStyle}" />
      </StackPanel>

      <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsTearOffVisible, Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Slider x:Uid="MediaSetup_TearOff" StepFrequency="1" Width="360" HorizontalAlignment="Left"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Minimum="{x:Bind ViewModel.TearOffMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.TearOffMax, Mode=OneWay}"
                Value="{x:Bind ViewModel.TearOff, Mode=TwoWay}" />
        <controls:MediaDiagram Grid.Column="1" Kind="TearBar" />
      </Grid>

      <!-- Spec §6 step 3: length-only setup for continuous media or when gap detection can't work. -->
      <StackPanel x:Name="LengthOnlySection" Spacing="8" Visibility="{x:Bind ViewModel.IsLengthOnlyVisible, Mode=OneWay}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <TextBlock x:Uid="MediaSetup_LengthOnly_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Uid="MediaSetup_LengthOnly_Body" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <NumberBox x:Uid="MediaSetup_LengthOnly_Length" SpinButtonPlacementMode="Compact" SmallChange="8" Width="200"
                     Minimum="{x:Bind ViewModel.LabelLengthMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.LabelLengthMax, Mode=OneWay}"
                     Value="{x:Bind ViewModel.LengthOnlyDots, Mode=TwoWay}" />
          <Button x:Uid="MediaSetup_LengthOnly_Apply" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ApplyLengthOnlyCommand, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
