<Page x:Class="LabelStudio.App.Views.PrintersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:LabelStudio.App"
      xmlns:vm="using:LabelStudio.ViewModels.Printers"
      Unloaded="OnUnloaded">
  <Page.Resources>
    <DataTemplate x:Key="KeyValueTemplate" x:DataType="vm:KeyValueRow">
      <Grid ColumnSpacing="12" Padding="0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="272" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <!-- Master: USB printers -->
    <Grid Padding="12" RowSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid>
        <TextBlock x:Uid="Printers_ListHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
        <Button x:Uid="Printers_Refresh" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
      </Grid>
      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Printers}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPrinterClicked">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:PrinterListItem">
            <Grid ColumnSpacing="10" Padding="0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE749;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Serial}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="Printers_CurrentBadge" Visibility="{x:Bind IsCurrent}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock Grid.Row="1" x:Uid="Printers_EmptyList" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Visibility="{x:Bind ViewModel.HasNoPrinters, Mode=OneWay}" />
    </Grid>

    <!-- Detail: dashboard -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Padding="32,22" Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Printers_Feed" Command="{x:Bind ViewModel.FeedCommand}" />
            <Button Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePauseCommand}" />
            <Button x:Uid="Printers_TestLabel" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PrintTestLabelCommand}" />
          </StackPanel>
        </Grid>

        <!-- Status card: replaces LED blink interpretation with words (spec §5). -->
        <InfoBar IsOpen="True" IsClosable="False"
                 Severity="{x:Bind app:XamlHelpers.ToSeverity(ViewModel.Status.Tone), Mode=OneWay}"
                 Title="{x:Bind ViewModel.Status.Title, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Status.Body, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Assertive">
          <InfoBar.ActionButton>
            <Button Content="{x:Bind ViewModel.Status.ActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StatusActionCommand}"
                    Visibility="{x:Bind app:XamlHelpers.VisibleWhenNotNull(ViewModel.Status.ActionLabel), Mode=OneWay}" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar Severity="Error" IsClosable="True"
                 IsOpen="{x:Bind app:XamlHelpers.IsNotNull(ViewModel.CommandError), Mode=OneWay}"
                 Message="{x:Bind ViewModel.CommandError, Mode=OneWay}" />

        <SelectorBar SelectionChanged="OnSectionChanged">
          <SelectorBarItem x:Uid="Printers_Overview" Tag="overview" IsSelected="True" />
          <SelectorBarItem x:Uid="Printers_Capabilities" Tag="capabilities" />
        </SelectorBar>

        <Grid x:Name="OverviewSection"><!-- toggled by the SelectorBar -->
        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock x:Uid="Printers_IdentityCard" Style="{StaticResource SubtitleTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Identity}" ItemTemplate="{StaticResource KeyValueTemplate}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock x:Uid="Printers_MediaCard" Style="{StaticResource SubtitleTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Media}" ItemTemplate="{StaticResource KeyValueTemplate}" />
            </StackPanel>
          </Border>
        </Grid>
        </Grid>

        <StackPanel x:Name="CapabilitiesPanel" Spacing="12" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="Printers_CapabilitiesIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" x:Uid="Printers_Reprobe" Command="{x:Bind ViewModel.ReprobeCommand}" />
          </Grid>
          <Border Style="{StaticResource CardStyle}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.ProbedKeys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SgdKeyRow">
                  <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Key}" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                      <TextBlock Text="{x:Bind ResponseText}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
