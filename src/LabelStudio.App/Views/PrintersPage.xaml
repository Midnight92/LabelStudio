<Page x:Class="LabelStudio.App.Views.PrintersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:LabelStudio.App"
      xmlns:vm="using:LabelStudio.ViewModels.Printers"
      xmlns:printers="using:LabelStudio.App.Views.Printers"
      xmlns:status="using:LabelStudio.ViewModels.Status">
  <Page.Resources>
    <DataTemplate x:Key="KeyValueTemplate" x:DataType="vm:KeyValueRow">
      <Grid ColumnSpacing="12" Padding="0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource NumericValueTextStyle}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="272" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <!-- Master: USB printers -->
    <Grid Padding="12" RowSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid>
        <TextBlock x:Uid="Printers_ListHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
        <Button x:Uid="Printers_Refresh" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
      </Grid>
      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Printers}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPrinterClicked">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:PrinterListItem">
            <Grid ColumnSpacing="10" Padding="0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE749;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Serial}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                            Visibility="{x:Bind app:XamlHelpers.VisibleWhenNotNull(Status)}">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind app:XamlHelpers.ToneBrush(Status.Tone)}" />
                  <FontIcon Glyph="{x:Bind Status.Glyph}" FontSize="12" />
                  <TextBlock Text="{x:Bind Status.Title}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <TextBlock x:Uid="Printers_CurrentBadge" Visibility="{x:Bind IsCurrent}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16"
                  Visibility="{x:Bind ViewModel.HasNoPrinters, Mode=OneWay}">
        <FontIcon Glyph="&#xE749;" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Uid="Printers_EmptyList" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Uid="Printers_EmptyRefresh" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
      </StackPanel>
    </Grid>

    <!-- Detail: dashboard -->
    <ScrollViewer Grid.Column="1">
      <!-- HorizontalAlignment="Left" on this wrapper anchors the dashboard next to the master list instead of
           centring it; MaxWidth here (not on the StackPanel) still gives the StackPanel's Stretch-aligned
           children a real, capped measure constraint, so the Identity/Media star columns size correctly. -->
      <Grid HorizontalAlignment="Left" MaxWidth="1040">
      <StackPanel Padding="32,22" Spacing="16">
        <Grid ColumnSpacing="8" RowSpacing="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" Width="20" Height="20"
                          Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Printers_Feed" Command="{x:Bind ViewModel.FeedCommand}" />
            <Button Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePauseCommand}" />
            <Button x:Uid="Printers_TestLabel" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PrintTestLabelCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ActionHint, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Right"
                     Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Visibility="{x:Bind app:XamlHelpers.VisibleWhenNotNull(ViewModel.ActionHint), Mode=OneWay}" />
        </Grid>

        <!-- Status card: replaces LED blink interpretation with words (spec §5). -->
        <InfoBar x:Name="StatusCard" IsOpen="True" IsClosable="False"
                 Severity="{x:Bind app:XamlHelpers.ToSeverity(ViewModel.Status.Tone), Mode=OneWay}"
                 Title="{x:Bind ViewModel.Status.Title, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Status.Body, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Assertive">
          <InfoBar.ActionButton>
            <Button Content="{x:Bind ViewModel.Status.ActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StatusActionCommand}"
                    Visibility="{x:Bind app:XamlHelpers.VisibleWhenNotNull(ViewModel.Status.ActionLabel), Mode=OneWay}" />
          </InfoBar.ActionButton>
        </InfoBar>
        <HyperlinkButton x:Uid="Printers_BlinkCodesLink" Command="{x:Bind ViewModel.OpenBlinkCodesCommand}" Padding="0" />
        <InfoBar Severity="Error" IsClosable="True"
                 IsOpen="{x:Bind app:XamlHelpers.IsNotNull(ViewModel.CommandError), Mode=OneWay}"
                 Message="{x:Bind ViewModel.CommandError, Mode=OneWay}" />

        <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
          <SelectorBarItem x:Uid="Printers_Overview" Tag="Overview" IsSelected="True" />
          <SelectorBarItem x:Uid="Printers_Calibration" Tag="Calibration" />
          <SelectorBarItem x:Uid="Printers_Capabilities" Tag="Capabilities" />
        </SelectorBar>

        <Grid x:Name="OverviewSection">
          <Grid ColumnSpacing="16" RowSpacing="16" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="8">
                <TextBlock x:Uid="Printers_IdentityCard" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Identity}" ItemTemplate="{StaticResource KeyValueTemplate}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock x:Uid="Printers_MediaCard" Style="{StaticResource SubtitleTextBlockStyle}" />
                  <HyperlinkButton x:Uid="Printers_EditMedia" HorizontalAlignment="Right" Command="{x:Bind ViewModel.EditMediaCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Media}" ItemTemplate="{StaticResource KeyValueTemplate}" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasCounters, Mode=OneWay}">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock x:Uid="Printers_CountersCard" Style="{StaticResource SubtitleTextBlockStyle}" />
                  <Button x:Uid="Printers_RefreshCounters" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCountersCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Counters}" ItemTemplate="{StaticResource KeyValueTemplate}" />
                <Grid ColumnSpacing="12" Padding="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock x:Uid="Printers_AppCounter" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppCounterText, Mode=OneWay}" Style="{StaticResource NumericValueTextStyle}" />
                  <Button Grid.Column="2" x:Uid="Printers_ResetCounter" IsEnabled="{x:Bind ViewModel.CanResetCounter, Mode=OneWay}">
                    <Button.Flyout>
                      <Flyout x:Name="ResetFlyout">
                        <StackPanel Spacing="12" MaxWidth="280">
                          <TextBlock x:Uid="Printers_ResetCounterConfirm" TextWrapping="Wrap" />
                          <Button x:Uid="Printers_ResetCounterYes" Style="{StaticResource AccentButtonStyle}"
                                  Command="{x:Bind ViewModel.ResetCounterCommand}" Click="OnResetConfirmed" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock x:Uid="Printers_OverviewEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Visibility="{x:Bind app:XamlHelpers.CollapsedWhen(ViewModel.IsConnected), Mode=OneWay}" />
        </Grid>

        <StackPanel x:Name="CalibrationSection" Spacing="16" Visibility="Collapsed">
          <printers:SmartCalPanel x:Name="SmartCalSection" ViewModel="{x:Bind ViewModel.Calibration}" />
          <Expander x:Name="CheckerExpander" x:Uid="Printers_CheckerExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <printers:CompatibilityCheckerPanel ViewModel="{x:Bind ViewModel.Checker}" />
          </Expander>
          <printers:MediaSetupPanel x:Name="MediaSetupSection" ViewModel="{x:Bind ViewModel.MediaSetup}" />
        </StackPanel>

        <StackPanel x:Name="CapabilitiesPanel" Spacing="12" Visibility="Collapsed">
          <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Uid="Printers_CapabilitiesIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button Grid.Column="1" x:Uid="Printers_Reprobe" Command="{x:Bind ViewModel.ReprobeCommand}" />
            </Grid>
            <Border Style="{StaticResource CardStyle}">
              <ItemsControl ItemsSource="{x:Bind ViewModel.ProbedKeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SgdKeyRow">
                    <Grid ColumnSpacing="12" Padding="0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Key}" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                        <TextBlock Text="{x:Bind ResponseText}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
          <TextBlock x:Uid="Printers_CapabilitiesEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Visibility="{x:Bind app:XamlHelpers.CollapsedWhen(ViewModel.IsConnected), Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
