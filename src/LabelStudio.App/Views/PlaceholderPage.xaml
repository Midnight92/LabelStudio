<Page x:Class="LabelStudio.App.Views.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480" Padding="24">
    <FontIcon Glyph="&#xE822;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
    <TextBlock x:Name="PageBody" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Button x:Uid="Placeholder_GoToPrinters" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnGoToPrinters" />
  </StackPanel>
</Page>
